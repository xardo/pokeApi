    "@expo/ui": "~57.0.19",
    "expo": "~57.0.24",
    "expo-asset": "^57.0.18",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "server": "node server.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "seed:pokemon": "node ./services/pokemon-service-node/seed.js",
    "seed:anime": "python ./services/anime-service-python/seed_firebase.py",
    "server:profesor": "node ./services/profesor-service-node/server.js",
    "service:docente:consultar": "node ./services/docente-consultar-service/server.js",
    "service:docente:crear": "node ./services/docente-crear-service/server.js",
    "service:docente:actualizar": "node ./services/docente-actualizar-service/server.js",
    "service:docente:eliminar": "node ./services/docente-eliminar-service/server.js",
    "services:docentes:all": "powershell -ExecutionPolicy Bypass -Command \"Start-Process node ./services/docente-consultar-service/server.js; Start-Process node ./services/docente-crear-service/server.js; Start-Process node ./services/docente-actualizar-service/server.js; Start-Process node ./services/docente-eliminar-service/server.js; Write-Host 'Microservicios iniciados en puertos 4001, 4002, 4003 y 4004'\"",
    "zip": "powershell -ExecutionPolicy Bypass -File ./scripts/create-submission-zip.ps1"
  },
  "private": true
}
