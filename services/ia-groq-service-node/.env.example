# Puerto del microservicio Groq (Render asigna uno automáticamente)
PORT=4006

# API Key de Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=gsk_TU_API_KEY_DE_GROQ_AQUI

# Modelo por defecto (llama-3.3-70b-versatile o llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# (Opcional) URL de PostgreSQL / Neon
DATABASE_URL=

# URLs de los microservicios en Render
POKEMON_SERVICE_URL=https://pokeapi-cmsz.onrender.com
ANIME_SERVICE_URL=https://anime-service-python.onrender.com

# Límite máximo de preguntas para el modo Base de Datos
MAX_QUESTIONS_LIMIT=10
