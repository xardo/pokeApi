# Puerto del microservicio (Render asigna uno automáticamente)
PORT=4005

# API Key de Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=TU_API_KEY_DE_GOOGLE_AI_STUDIO_AQUI

# Modelo de Gemini (opcional, por defecto usa gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# (Opcional) URL de la base de datos PostgreSQL / Neon para consultar los 10 Pokémon directamente
DATABASE_URL=

# URLs de tus microservicios en Render para obtener en tiempo real los 10 Pokémon y los 10 personajes de Anime
POKEMON_SERVICE_URL=https://pokeapi-cmsz.onrender.com
ANIME_SERVICE_URL=https://anime-service-python.onrender.com
